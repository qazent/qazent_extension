{
  "manifestVersion": 1,
  "id": "pr-assistant-extension-qazent-validator-test",
  "name": "PR Assistant Validator Test",
  "version": "3.1.0",
  "public": true,
  "publisher": "QAZent",
  "description": "Temporary paid extension manifest for Azure DevOps Marketplace validation testing.",
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "galleryFlags": [
    "Paid",
    "Public"
  ],
  "galleryproperties": {
    "trialDays": "14"
  },
  "tags": [
    "__BYOLENFORCED",
    "pull-request",
    "testing"
  ],
  "content": {
    "details": { "path": "overview.md" },
    "pricing": { "path": "pricing.md" },
    "license": { "path": "license-terms.md" },
    "privacy": { "path": "privacy-policy.md" }
  },
  "licensing": {
    "overrides": [
      { "id": "pr-assistant-validator-test-tab", "behavior": "AlwaysInclude" }
    ]
  },
  "icons": {
    "default": "128x128.png"
  },
  "categories": [
    "Azure Repos"
  ],
  "links": {
    "learn": {
      "uri": "https://www.qazent.com"
    },
    "support": {
      "uri": "https://www.qazent.com/support"
    },
    "license": {
      "uri": "https://www.qazent.com/license"
    },
    "privacypolicy": {
      "uri": "https://www.qazent.com/privacy"
    }
  },
  "contributions": [
    {
      "id": "pr-assistant-validator-test-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "Generate Test Cases",
        "order": 100,
        "uri": "hub.html"
      }
    }
  ],
  "files": [
    { "path": "hub.html", "addressable": true },
    { "path": "hub.js", "addressable": true }
  ],
  "scopes": [
    "vso.code"
  ]
}
