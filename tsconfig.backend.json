{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "server.ts",
    "logger.ts",
    "types.ts",
    "queue.ts",
    "ai.ts",
    "ado-client.ts",
    "fetchPRdiff.ts"
  ],
  "exclude": [
    "src",
    "node_modules",
    "dist",
    "*.test.ts",
    "jest.config.ts",
    "jest.setup.ts",
    "jest-check.ts",
    "test-local.ts"
  ]
}