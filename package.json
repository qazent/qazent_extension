{
  "name": "azure-devops-pr-testcase-generator",
  "version": "1.2.5",
  "description": "Generates AI-powered test cases from Azure DevOps PRs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "ts-node server.ts",
    "build": "tsc && cpx system-prompt.txt dist && cpx test-local.ts dist ",
    "build:extension": "webpack --config webpack.config.js --mode production",
    "dev:extension": "webpack --config webpack.config.js --mode development --watch",
    "package:extension": "tfx extension create --manifest-globs vss-extension.json --rev-version",
    "start": "node dist/server.js",
    "test:local": "ts-node test-local.ts",
    "lint": "tsc --noEmit",
    "test:jest": "jest --config jest.config.ts"
  },
  "keywords": [
    "azure-devops",
    "test-case",
    "ai",
    "pull request",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fluentui/react-components": "^9.73.0",
    "@google/genai": "^1.35.0",
    "azure-devops-extension-api": "^4.0.2",
    "azure-devops-extension-sdk": "^4.2.0",
    "azure-devops-node-api": "^12.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "jsonrepair": "^3.13.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "cpx": "^1.5.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  }
}
