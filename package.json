{
  "name": "azure-devops-pr-testcase-generator",
  "version": "1.0.0",
  "description": "Generates AI-powered test cases from Azure DevOps PRs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "ts-node server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:local": "ts-node test-local.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "azure-devops",
    "test-case",
    "ai",
    "webhook",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "azure-devops-node-api": "^12.5.0",
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.0"
  }
}
