{
  "version": "3.1.16",
  "id": "pr-assistant-extension-qazent",
  "name": "azure-test-extension",
  "public": true,
  "publisher": "QAZent",
  "description": "AI-powered PR test case generation assistant",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  },
  "galleryFlags": [
    "Paid"
  ],
  "scripts": {
    "dev": "ts-node server.ts",
    "build": "npm run build:extension && npm run build:backend",
    "copy:extension-assets": "cpx \"*.md\" dist/ && cpx \"icon.png\" dist/ && cpx \"vss-extension.json\" dist/ && cpx \"public/*.png\" dist/public/ && cpx \"public/*.gif\" dist/public/",
    "build:extension": "webpack --config webpack.config.js && npm run copy:extension-assets",
    "build:backend": "tsc -p tsconfig.backend.json && cpx system-prompt.txt dist/ && cpx system-prompt.txt dist/backend/ && cpx system-prompt-review.txt dist/ && cpx system-prompt-review.txt dist/backend/",
    "dev:extension": "webpack --config webpack.config.js --mode development --watch",
    "patch:marketplace-manifests": "powershell -ExecutionPolicy Bypass -File scripts/patch-marketplace-manifests.ps1 -VsixDirectory ./output -VsixPrefix QAZent.pr-assistant-extension-qazent- -SourceManifestPath ./dist/vss-extension.json",
    "package:extension": "tfx extension create --root dist --manifest-globs vss-extension.json --output-path ./output && npm run patch:marketplace-manifests",
    "publish:all": "powershell src/backend/utils/publish-all.ps1",
    "start": "node dist/backend/server.js",
    "start:worker": "node dist/backend/worker/worker.js",
    "test": "jest --config jest.config.ts",
    "test:local": "ts-node tests/test-local.ts",
    "lint": "tsc --noEmit",
    "test:jest": "jest --config jest.config.ts",
    "test:context": "jest --config jest.config.ts --testPathPattern=customContext"
  },
  "tags": [
    "__BYOLENFORCED",
    "pull-request",
    "testing",
    "ai",
    "test",
    "utility",
    "automatic",
    "agile"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fluentui/react-combobox": "^9.15.0",
    "@fluentui/react-components": "^9.73.0",
    "@google/genai": "^1.35.0",
    "@upstash/redis": "^1.37.0",
    "azure-devops-extension-api": "^4.0.2",
    "azure-devops-extension-sdk": "^4.2.0",
    "azure-devops-node-api": "^12.5.0",
    "cors": "^2.8.5",
    "jsonrepair": "^3.13.2",
    "pg": "^8.13.0",
    "postgres": "^3.4.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sanitize-html": "^2.17.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.13",
    "@types/dotenv": "^8.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^9.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "cpx": "^1.5.0",
    "dotenv": "^16.4.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-dom": "^4.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jest-junit": "^17.0.0",
    "react-testing-library": "^8.0.1",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  }
}
