{
  "manifestVersion": 1,
  "id": "pr-assistant-extension",
  "name": "PR Assistant",
  "version": "2.0.9",
  "publisher": "QAZent",
  "description": "AI-powered PR test case generation assistant",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],

  "galleryFlags": [
    "Public"
  ],

  "icons": {
    "default": "128x128.png"
  },
  "branding": {
        "color": "#00BFFF",
        "theme": "dark"
    },

  "categories": ["Azure Repos", "Azure Boards"],
  
  "tags": ["pull-request", 
  "testing", 
  "ai", "test", 
  "utility", 
  "automatic", 
  "agile"],
  
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license":{
      "path":"license-terms.md"
    }

  },
  "badge": {  
    "url": "https://img.shields.io/badge/status-stable-brightgreen",
    "description": "Indicates that the extension is stable and ready for production use."
  },
  "link": [
    {
      "name": "QAZent Website",
      "url": "https://www.qazent.com"
    }
  ],

  "contributions": [

    {
      "id": "ai-context-settings-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "QAZent - AI Context Settings",
        "order": 100,
        "uri": "dist/settings.html",
        "backendUrl": "https://api.qazent.com"      }
    }
    ,
        {
      "id": "pr-assistant-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "Generate Testcase",
        "order": 100,
        "uri": "dist/hub.html",
        "backendUrl": "https://api.qazent.com"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "overview.md",
      "addressable": true
    },
    {
      "path": "license-terms.md",
      "addressable": true
    },
    {
      "path": "public",
      "addressable": true
    }
  ],
  "scopes": ["vso.code", 
  "vso.work_write",
  "vso.notification_write", 
  "vso.hooks_interact", 
  "vso.threads_full",
  "vso.extension.data_write"
  ]
}
