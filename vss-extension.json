{
  "manifestVersion": 1,
  "id": "QAZent",
  "name": "PR Assistant",
  "version": "1.2.86",
  "publisher": "QAZent",
  "description": "AI-powered PR test case generation assistant",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],

  "galleryFlags": [
    "Public"
  ],

  "icons": {
    "default": "128x128.png"
  },
  "branding": {
        "color": "#00BFFF",
        "theme": "dark"
    },

  "categories": ["Azure Repos", 
  "Pull Requests", 
  "AI", 
  "Testing", 
  "Utilities"],
  
  "tags": ["pull-request", 
  "testing", 
  "ai", "test", 
  "utility", 
  "automatic", 
  "agile"],
  
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license":{
      "path":"license-terms.md"
    }

  },
  "link": [
    {
      "name": "QAZent Website",
      "url": "https://www.qazent.com"
    }
  ],
  "screenshots": [
    {
      "alt": "Generate Testcase Screenshot",
      "path": "public/generate-testcase.png"
    },
    {
      "alt": "Custom Context",
      "path": "public/step-3.png"
    },
    {
      "alt": "Linking PR Screenshot",
      "path": "public/work-item-created.png"
    },
    {
      "alt": "Workitem Created Screenshot",
      "path": "public/generated-test-case.png"
    }
    
  ],
  "contributions": [

    {
      "id": "ai-context-settings-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "QAZent PR Assistant",
        "order": 100,
        "uri": "dist/settings.html",
        "backendUrl": "https://api.qazent.com"      }
    }
    ,
        {
      "id": "pr-assistant-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "QAZent - PR Assistant",
        "order": 100,
        "uri": "dist/hub.html",
        "backendUrl": "https://api.qazent.com"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "overview.md",
      "addressable": true
    },
    {
      "path": "license-terms.md",
      "addressable": true
    },
    {
      "path": "public",
      "addressable": true
    }
  ],
  "scopes": ["vso.code_write", 
  "vso.work_write",
  "vso.notification_write", 
  "vso.hooks_interact", 
  "vso.threads_full"
  ]
}
