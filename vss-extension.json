{
  "manifestVersion": 1,
  "id": "pr-assistant-extension-qazent",
  "name": "PR Assistant",
  "version": "3.1.1",
  "public": true,
  "publisher": "QAZent",
  "description": "AI-powered PR test case generation assistant",

  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],

  "galleryFlags": [
    "Paid",
    "Preview"
  ],

  "galleryproperties": {
    "trialDays": "14"
  },

  "tags": [
    "__BYOLENFORCED",
    "pull-request",
    "testing",
    "ai",
    "test",
    "utility",
    "automatic",
    "agile"
  ],

  "content": {
    "details": { "path": "overview.md" },
    "pricing": { "path": "pricing.md" },
    "license": { "path": "license-terms.md" },
    "privacy": { "path": "privacy-policy.md" }
  },

  "licensing": {
    "overrides": [
      { "id": "ai-context-settings-hub", "behavior": "AlwaysInclude" },
      { "id": "pr-assistant-tab", "behavior": "AlwaysInclude" }
    ]
  },

  "assets": [
    {
      "path": "privacy-policy.md",
      "addressable": true,
      "contentType": "text/markdown",
      "type": "Microsoft.VisualStudio.Services.Content.Privacy"
    },
    {
      "path": "license-terms.md",
      "addressable": true,
      "contentType": "text/markdown",
      "type": "Microsoft.VisualStudio.Services.Content.License"
    },
    {
      "path": "pricing.md",
      "addressable": true,
      "contentType": "text/markdown",
      "type": "Microsoft.VisualStudio.Services.Content.Pricing"
    },
    {
      "path": "overview.md",
      "addressable": true,
      "contentType": "text/markdown",
      "type": "Microsoft.VisualStudio.Services.Content.Details"
    }
  ],

  "icons": {
    "default": "128x128.png"
  },

  "branding": {
    "color": "#1F2937",
    "theme": "dark"
  },

  "categories": [
    "Azure Repos",
    "Azure Boards"
  ],

  "links": {
    "learn": {
      "uri": "https://www.qazent.com"
    },
    "support": {
      "uri": "https://www.qazent.com/support"
    },
    "license": {
      "uri": "https://www.qazent.com/license"
    },
    "privacypolicy": {
      "uri": "https://www.qazent.com/privacy"
    }
  },

  "contributions": [
    {
      "id": "ai-context-settings-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "QAZent - AI Context Settings",
        "order": 100,
        "uri": "settings.html"
      }
    },
    {
      "id": "pr-assistant-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "Generate Test Cases",
        "order": 100,
        "uri": "hub.html"
      }
    }
  ],

  "files": [
    { "path": "public", "addressable": true },
    { "path": "hub.html", "addressable": true },
    { "path": "settings.html", "addressable": true },
    { "path": "hub.js", "addressable": true },
    { "path": "settings.js", "addressable": true }
  ],

  "scopes": [
    "vso.code",
    "vso.work_write",
    "vso.notification_write",
    "vso.hooks_interact",
    "vso.threads_full",
    "vso.extension.data_write"
  ]
}
