{
  "manifestVersion": 1,
  "id": "pr-assistant-extension",
  "name": "PR Assistant",
  "version": "1.2.16",
  "publisher": "QAZent",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "description": "AI-powered PR test case generation assistant",
  "categories": ["Azure Repos"],
  "tags": ["pull-request", "testing", "ai"],
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "contributions": [
    {
      "id": "pr-assistant-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "QAZent PR Assistant",
        "uri": "dist/hub.html",
        "order": 100
      }
    },
    {
      "id": "ai-context-settings-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "QAZent PR Assistant",
        "order": 100,
        "uri": "dist/settings.html"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    }
  ],
  "scopes": ["vso.code"]
}
