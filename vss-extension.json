{
  "manifestVersion": 1,
  "id": "pr-assistant-extension",
  "name": "PR Assistant",
  "version": "1.2.47",
  "publisher": "QAZent",
  "description": "AI-powered PR test case generation assistant",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "128x128.png"
  },
  "branding": {
        "color": "#00BFFF",
        "theme": "dark"
    },

  "categories": ["Azure Repos"],
  
  "tags": ["pull-request", "testing", "ai", "test", "utility", "automatic", "agile"],
  
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license":{
      "path":"license-terms.md"
    }
  },
  "contributions": [

    {
      "id": "ai-context-settings-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "QAZent PR Assistant",
        "order": 100,
        "uri": "dist/settings.html",
        "backendUrl": "https://rathely-rubidic-katelin.ngrok-free.dev/"      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
       "path": "output",
      "addressable": true 
      }
  ],
  "scopes": ["vso.code"]
}
