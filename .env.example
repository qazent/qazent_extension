# Azure DevOps Configuration
# NOTE: Organization URL is now provided dynamically per request via X-Ado-Org-Url header
# No longer required: ADO_ORG_URL (multi-tenant support)
# ADO_PAT is optional - only needed for development testing without real OAuth tokens
# ADO_PAT=your-personal-access-token-here  # OPTIONAL: For development only

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here  # PRODUCTION: Store in Azure Key Vault

# Server Configuration
PORT=3000
NODE_ENV=development  # Set to 'production' in production

# Development Only (remove in production)
NGROK_URL=https://your-ngrok-url.ngrok-free.dev

# Logging (optional)
DEBUG=false

# Testing (optional)
MOCK_MODE=false

# ============================================================
# HOW TO GET YOUR CREDENTIALS
# ============================================================

# How to get Azure DevOps PAT (OPTIONAL - for development only):
# Production uses user OAuth tokens from frontend extension
# Development can use PAT for testing:
# 1. Go to https://dev.azure.com/{org}/_usersSettings/tokens
# 2. Click "New Token"
# 3. Give it a name like "PR Test Case Generator"
# 4. Set expiration (recommend 90 days or custom)
# 5. Select scopes:
#    - Code: Read
#    - Work Items: Read, Write
# 6. Click "Create"
# 7. Copy token immediately (only shown once!)
# 8. Paste it as ADO_PAT value above

# How to get Gemini API Key:
# 1. Go to https://makersuite.google.com/app/apikey
# 2. Click "Create API key"
# 3. Select a Google Cloud project (or create new one)
# 4. Copy the API key
# 5. Paste it as GEMINI_API_KEY value above

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================

# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual values in .env
#
# 3. Never commit .env to git (it's in .gitignore)
#
# 4. For production (Azure App Service), set these as
#    Application Settings in the Azure Portal
#
# ============================================================
# PRODUCTION SECURITY RECOMMENDATIONS
# ============================================================
#
# 1. NEVER store GEMINI_API_KEY in App Service configuration
# 2. Use Azure Key Vault to store sensitive credentials
# 3. Configure Managed Identity for App Service to access Key Vault
# 4. Set NODE_ENV=production in production environment
# 5. Remove NGROK_URL from production (development only)
# 6. ADO_PAT is optional in production (user tokens preferred)
# 7. If using PAT for development, rotate regularly (recommend every 90 days)
#
# ============================================================
# AUTHENTICATION ARCHITECTURE (MULTI-TENANT SUPPORT)
# ============================================================
#
# This backend supports multi-tenant Azure DevOps organizations:
# - Frontend extension obtains token via SDK.getAccessToken() for user's org
# - All API requests include:
#   * Authorization: Bearer <token> header (user's OAuth token)
#   * X-Ado-Org-Url header (e.g., https://dev.azure.com/orgname)
# - Backend validates token against provided organization
# - User identity verified and operations use user's token
# - Backend ADO_PAT is optional (for development/testing only)
# - Each user can connect from their own unique Azure DevOps organization
#
