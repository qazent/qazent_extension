    {
      "name": "3. Generate Test Cases",
      "item": [
        {
          "name": "POST - Generate with Custom Context",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains test case title\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.exist;",
                  "    pm.expect(jsonData.title.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"Test case has required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.htmlDescriptionBase64).to.exist;",
                  "    pm.expect(jsonData.htmlDescriptionBase64.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"Optional fields are present\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.purpose || jsonData.scopeOfChange).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Response time is reasonable (< 60s)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "",
                  "// Save test case for next request",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"generatedTestCase\", JSON.stringify(jsonData));",
                  "pm.collectionVariables.set(\"sourceCommitId\", jsonData.sourceCommitId || \"\");",
                  "pm.collectionVariables.set(\"targetCommitId\", jsonData.targetCommitId || \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Ado-Org-Url",
                "value": "{{orgUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prId\": {{prId}},\n  \"projectName\": \"{{projectName}}\",\n  \"repositoryId\": \"{{repositoryId}}\",\n  \"customContext\": \"This PR adds a new REST API endpoint for user authentication. Focus on security, input validation, error handling, and edge cases in test cases.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/generate-tests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generate-tests"
              ]
            },
            "description": "Generate test cases from PR code changes using AI"
          },
          "response": []
        },
        {
          "name": "POST - Generate without Custom Context",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains test case\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Ado-Org-Url",
                "value": "{{orgUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prId\": {{prId}},\n  \"projectName\": \"{{projectName}}\",\n  \"repositoryId\": \"{{repositoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/generate-tests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generate-tests"
              ]
            },
            "description": "Generate test cases from PR code changes without custom context"
          },
          "response": []
        }
      ]
