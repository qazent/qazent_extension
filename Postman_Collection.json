    {
      "name": "4. Create Work Item",
      "item": [
        {
          "name": "POST - Create Task Work Item",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains workItemId and URL\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.workItemId).to.exist;",
                  "    pm.expect(jsonData.workItemUrl).to.exist;",
                  "    pm.expect(jsonData.workItemId).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Work item URL contains proper format\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.workItemUrl).to.include(\"dev.azure.com\");",
                  "    pm.expect(jsonData.workItemUrl).to.include(\"_workitems/edit/\");",
                  "});",
                  "",
                  "pm.test(\"Response time is reasonable (< 30s)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(30000);",
                  "});",
                  "",
                  "// Save workItemId and URL for next request",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"workItemId\", jsonData.workItemId);",
                  "pm.collectionVariables.set(\"workItemUrl\", jsonData.workItemUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Ado-Org-Url",
                "value": "{{orgUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"testCase\": {\n    \"title\": \"Test OAuth2 Authentication Endpoint\",\n    \"htmlDescriptionBase64\": \"<h2>Test Case: OAuth2 Authentication</h2><p>This test case validates the OAuth2 authentication flow and token generation.</p>\",\n    \"purpose\": \"Validate OAuth2 token generation and expiration\",\n    \"scopeOfChange\": \"Added new /auth/oauth/token endpoint with JWT support\",\n    \"preconditions\": [\n      \"API server is running\",\n      \"Database with test users is available\",\n      \"OAuth provider is accessible\"\n    ],\n    \"testSteps\": [\n      \"1. Send POST request to /auth/oauth/token with valid credentials\",\n      \"2. Verify token is generated and contains required claims\",\n      \"3. Use token in Authorization header for subsequent requests\",\n      \"4. Verify token expiration time is 1 hour\"\n    ],\n    \"expectedResults\": [\n      \"Token endpoint returns 200 OK\",\n      \"Response contains access_token and expires_in fields\",\n      \"Token can be decoded and verified with server public key\"\n    ],\n    \"negativeScenarios\": [\n      \"Invalid credentials return 401 Unauthorized\",\n      \"Missing credentials return 400 Bad Request\",\n      \"Expired token returns 401 Unauthorized\"\n    ],\n    \"edgeCases\": [\n      \"Very long password (>1000 chars)\",\n      \"Special characters in username\",\n      \"Simultaneous token requests from same user\"\n    ],\n    \"regressionAreas\": [\n      \"Existing login endpoint compatibility\",\n      \"Session management\",\n      \"CORS for authentication endpoints\"\n    ],\n    \"dataRequirements\": [\n      \"Test user with known credentials\",\n      \"Test OAuth provider access\",\n      \"Database reset capability\"\n    ],\n    \"automationNotes\": \"Can be automated using REST API calls and JWT verification helpers\"\n  },\n  \"prId\": {{prId}},\n  \"projectName\": \"{{projectName}}\",\n  \"repositoryId\": \"{{repositoryId}}\",\n  \"projectId\": \"{{projectId}}\",\n  \"sourceCommitId\": \"{{sourceCommitId}}\",\n  \"targetCommitId\": \"{{targetCommitId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/create-work-item",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "create-work-item"
              ]
            },
            "description": "Create a Task work item in Azure DevOps from the generated test case"
          },
          "response": []
        }
      ]
    },
