{
  "info": {
    "_postman_id": "test-extension-api-collection",
    "name": "Azure DevOps PR Test Case Generator API",
    "description": "Complete API testing for PR test case generation with test cases and scripts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "GET - Health Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains healthy status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(\"healthy\");",
                  "});",
                  "",
                  "pm.test(\"Rate limit headers present\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-RateLimit-Limit\")).to.exist;",
                  "    pm.expect(pm.response.headers.get(\"X-RateLimit-Remaining\")).to.exist;",
                  "    pm.expect(pm.response.headers.get(\"X-RateLimit-Reset\")).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Response has uptime field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.uptime).to.be.a(\"number\");",
                  "    pm.expect(jsonData.uptime).to.be.greaterThanOrEqualTo(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if the backend API server is running and healthy"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Webhook",
      "item": [
        {
          "name": "POST - PR Created Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test(\"Response contains jobId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.jobId).to.exist;",
                  "    pm.expect(jsonData.status).to.equal(\"accepted\");",
                  "});",
                  "",
                  "pm.test(\"Rate limit headers present\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-RateLimit-Remaining\")).to.exist;",
                  "});",
                  "",
                  "// Save jobId for reference",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"lastJobId\", jsonData.jobId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"git.pullrequest.created\",\n  \"resource\": {\n    \"pullRequestId\": 123,\n    \"title\": \"Add new authentication feature\",\n    \"description\": \"Implements OAuth2 authentication for the API\",\n    \"repository\": {\n      \"id\": \"repo-abc-123\",\n      \"name\": \"MyRepository\",\n      \"url\": \"https://dev.azure.com/myorg/myproject/_git/MyRepository\",\n      \"project\": {\n        \"name\": \"MyProject\",\n        \"id\": \"proj-xyz-789\"\n      }\n    },\n    \"sourceRefName\": \"refs/heads/feature/auth\",\n    \"targetRefName\": \"refs/heads/main\",\n    \"createdBy\": {\n      \"displayName\": \"John Doe\",\n      \"uniqueName\": \"john.doe@example.com\",\n      \"id\": \"user-123\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook"
              ]
            },
            "description": "Receive a pull request created event from Azure DevOps webhook"
          },
          "response": []
        },
        {
          "name": "POST - PR Updated Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test(\"Response contains jobId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.jobId).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"git.pullrequest.updated\",\n  \"resource\": {\n    \"pullRequestId\": 124,\n    \"title\": \"Update authentication feature - add JWT support\",\n    \"description\": \"Updated OAuth2 implementation with JWT tokens\",\n    \"repository\": {\n      \"id\": \"repo-abc-123\",\n      \"name\": \"MyRepository\",\n      \"url\": \"https://dev.azure.com/myorg/myproject/_git/MyRepository\",\n      \"project\": {\n        \"name\": \"MyProject\",\n        \"id\": \"proj-xyz-789\"\n      }\n    },\n    \"sourceRefName\": \"refs/heads/feature/auth\",\n    \"targetRefName\": \"refs/heads/main\",\n    \"createdBy\": {\n      \"displayName\": \"Jane Smith\",\n      \"uniqueName\": \"jane.smith@example.com\",\n      \"id\": \"user-456\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook"
              ]
            },
            "description": "Receive a pull request updated event from Azure DevOps webhook"
          },
          "response": []
        }
      ]
